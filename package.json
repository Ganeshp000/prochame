{
  "name": "prochame",
  "version": "1.0.1",
  "description": "Prochame — A clean, modular, and privacy-first desktop overlay copilot that helps you in live calls and coding tasks.",
  "main": "src/main/index.js",
  "author": "Ganeshp000",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "pack": "npm run build && electron-builder",
    "pack:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.prochame.app",
    "productName": "Prochame",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/main/**/*",
      "src/preload/**/*",
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "Prochame requires microphone access to capture and transcribe your side of the conversation.",
        "NSCameraUsageDescription": "Prochame does not use the camera.",
        "NSAudioCaptureUsageDescription": "Prochame requires system audio access to capture and transcribe the other side of a call."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "docs/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/genai": "^0.3.0",
    "openai": "^4.73.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11"
  }
}
